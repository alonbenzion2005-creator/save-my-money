<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="12dp"
    android:paddingEnd="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/banner_background"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="14dp"
        android:paddingEnd="20dp"
        android:paddingBottom="16dp">

        <TextView
            android:id="@+id/banner_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/banner_text_secondary"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/banner_total"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/banner_text"
            android:textSize="32sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/banner_others"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/banner_text_secondary"
            android:textSize="14sp"
            android:visibility="gone" />

        <ProgressBar
            android:id="@+id/banner_budget"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:progressBackgroundTint="@color/banner_track"
            android:visibility="gone" />

        <TextView
            android:id="@+id/banner_detail"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="@color/banner_text_secondary"
            android:textSize="14sp" />
    </LinearLayout>
</FrameLayout>
