<?xml version="1.0" encoding="utf-8"?>
<com.savemymoney.app.service.OverlayRootLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/screen_background">

    <LinearLayout
        android:id="@+id/screen_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:letterSpacing="0.12"
            android:text="@string/app_name"
            android:textAllCaps="true"
            android:textColor="@color/banner_text_secondary"
            android:textSize="13sp" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/screen_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/banner_text_secondary"
            android:textSize="20sp" />

        <TextView
            android:id="@+id/screen_total"
            android:layout_width="match_parent"
            android:layout_height="96dp"
            android:autoSizeMaxTextSize="72sp"
            android:autoSizeMinTextSize="28sp"
            android:autoSizeTextType="uniform"
            android:gravity="center"
            android:maxLines="1"
            android:textColor="@color/banner_text"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/screen_others"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/banner_text_secondary"
            android:textSize="18sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/screen_detail"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@color/banner_text_secondary"
            android:textSize="18sp" />

        <LinearLayout
            android:id="@+id/screen_budget_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp"
            android:orientation="vertical"
            android:visibility="gone">

            <ProgressBar
                android:id="@+id/screen_budget"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="10dp"
                android:maxHeight="10dp"
                android:minHeight="10dp"
                android:progressBackgroundTint="@color/banner_track" />

            <TextView
                android:id="@+id/screen_budget_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:textColor="@color/banner_text"
                android:textSize="18sp" />
        </LinearLayout>

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/screen_continue"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@drawable/screen_button"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="@string/screen_continue"
            android:textColor="@color/screen_button_text"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>
</com.savemymoney.app.service.OverlayRootLayout>
